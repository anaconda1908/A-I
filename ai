  <!-- ================= JAVASCRIPT INTERAKTIF ================= -->
  <script>
    // =========================================================================
    // KONFIGURASI NOMOR WHATSAPP (Ubah satu variabel ini dengan nomor WA Anda)
    // Gunakan format internasional tanpa tanda '+' atau spasi (contoh: 6281234567890)
    // =========================================================================
    const WHATSAPP_NUMBER = "625694742790";

    // 1. Mobile Menu Toggle
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    mobileBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
    });
    document.querySelectorAll(".mobile-link").forEach(link => {
      link.addEventListener("click", () => mobileMenu.classList.add("hidden"));
    });

    // 2. Maskot Interaktif: Mata mengikuti kursor & merespons saat diklik
    const mascotEyes = document.getElementById("mascot-eyes");
    const mascotSpeech = document.getElementById("mascot-speech");
    const mascotQuotes = [
      "\"Mau website baru atau revamp? Gaskeun! 💻\"",
      "\"Butuh file .shp dengan patok tiap sudut buat OSS? Beres! 📍\"",
      "\"QR Lucky Spin & ulasan GMaps bikin toko makin rame! 🎡\"",
      "\"Email bisnis Microsoft 365 & Cloud siap kami rapikan! ☁️\"",
      "\"Yuk ngobrol santai dulu, gratis kok! ☕\""
    ];
    let quoteIndex = 0;

    document.addEventListener("mousemove", (e) => {
      if (!mascotEyes) return;
      const xRatio = (e.clientX / window.innerWidth - 0.5) * 8;
      const yRatio = (e.clientY / window.innerHeight - 0.5) * 6;
      mascotEyes.style.transform = `translate(${xRatio.toFixed(1)}px, ${yRatio.toFixed(1)}px)`;
    });

    function pokeMascot(event) {
      fireConfetti(event);
      quoteIndex = (quoteIndex + 1) % mascotQuotes.length;
      mascotSpeech.innerHTML = `<p class="font-display font-semibold text-sm sm:text-base text-aiNavy">${mascotQuotes[quoteIndex]}</p>`;
      mascotSpeech.classList.add("scale-105", "bg-amber-50");
      setTimeout(() => {
        mascotSpeech.classList.remove("scale-105", "bg-amber-50");
      }, 280);
    }

    // 3. Tab Switcher Mini Demo (Lucky Spin vs Patok Peta OSS)
    function switchDemoTab(tabName) {
      const spinPanel = document.getElementById("demo-panel-spin");
      const petaPanel = document.getElementById("demo-panel-peta");
      const btnSpin = document.getElementById("tab-btn-spin");
      const btnPeta = document.getElementById("tab-btn-peta");

      if (tabName === "spin") {
        spinPanel.classList.remove("hidden");
        petaPanel.classList.add("hidden");
        btnSpin.className = "btn-bouncy font-display font-bold text-sm sm:text-base px-5 py-3 rounded-2xl border-2 border-aiNavy bg-aiGold text-aiNavy shadow-btn-gold flex items-center gap-2";
        btnPeta.className = "btn-bouncy font-display font-bold text-sm sm:text-base px-5 py-3 rounded-2xl border-2 border-aiNavy bg-white text-aiNavy shadow-pop flex items-center gap-2";
      } else {
        petaPanel.classList.remove("hidden");
        spinPanel.classList.add("hidden");
        btnPeta.className = "btn-bouncy font-display font-bold text-sm sm:text-base px-5 py-3 rounded-2xl border-2 border-aiNavy bg-aiMint text-aiNavy shadow-btn-3d flex items-center gap-2";
        btnSpin.className = "btn-bouncy font-display font-bold text-sm sm:text-base px-5 py-3 rounded-2xl border-2 border-aiNavy bg-white text-aiNavy shadow-pop flex items-center gap-2";
      }
    }

    // 4. Logika Simulasi Lucky Spin
    let currentRotation = 0;
    let isSpinning = false;
    const wheelPrizes = [
      "Konsultasi VIP Gratis 30 Menit!",
      "Bonus Revisi Tambahan Website!",
      "Voucher Kopi Santai Diskusi!",
      "Audit Kecepatan Website Gratis!",
      "Gratis Setup QR Google Maps!",
      "Diskon Spesial 15% Paket Proyek!"
    ];

    function spinTheWheel() {
      if (isSpinning) return;
      isSpinning = true;

      const wheel = document.getElementById("lucky-wheel-svg");
      const resultText = document.getElementById("spin-result-text");
      const btnSpin = document.getElementById("btn-spin-now");

      btnSpin.disabled = true;
      btnSpin.classList.add("opacity-60");
      resultText.textContent = "⏳ Roda berputar... semoga dapat hadiah seru!";

      const extraSpins = 1440 + Math.floor(Math.random() * 360);
      currentRotation += extraSpins;
      wheel.style.transform = `rotate(${currentRotation}deg)`;

      setTimeout(() => {
        const normalizedDeg = currentRotation % 360;
        const prizeIndex = Math.floor(normalizedDeg / 60) % wheelPrizes.length;
        resultText.innerHTML = `🎉 Selamat! Kamu dapat: <span class="text-aiBlue underline">${wheelPrizes[prizeIndex]}</span>`;
        fireConfetti();
        isSpinning = false;
        btnSpin.disabled = false;
        btnSpin.classList.remove("opacity-60");
      }, 3250);
    }

    // 5. Logika Klik Titik Patok Peta OSS
    function inspectPatok(nomor, koordinat, label) {
      const box = document.getElementById("patok-info-box");
      document.getElementById("patok-title").textContent = `📍 Patok P-0${nomor} — ${label}`;
      document.getElementById("patok-coord").textContent = `Koordinat: ${koordinat}`;
      box.classList.add("scale-[1.02]", "bg-amber-50", "border-amber-400");
      setTimeout(() => {
        box.classList.remove("scale-[1.02]", "bg-amber-50", "border-amber-400");
      }, 260);
    }

    // 6. Pilih Layanan dari Kartu -> Otomatis Scroll & Set Dropdown Form
    function selectServiceAndScroll(serviceName) {
      const selectEl = document.getElementById("service-select");
      for (let i = 0; i < selectEl.options.length; i++) {
        if (selectEl.options[i].value === serviceName) {
          selectEl.selectedIndex = i;
          break;
        }
      }
      document.getElementById("kontak").scrollIntoView({ behavior: "smooth" });
    }

    // 7. Kirim Form ke WhatsApp (Tanpa alert())
    function sendToWhatsApp(event) {
      event.preventDefault();
      const name = document.getElementById("client-name").value.trim();
      const service = document.getElementById("service-select").value;
      const notes = document.getElementById("client-notes").value.trim();
      const feedback = document.getElementById("form-feedback");

      const message =
        `Halo Tim A&I! 👋\n\n` +
        `Perkenalkan saya *${name}*.\n` +
        `Saya tertarik dengan layanan: *${service}*\n\n` +
        `Detail kebutuhan:\n${notes}\n\n` +
        `Mohon info lanjutannya ya. Terima kasih!`;

      const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;

      feedback.classList.remove("hidden");
      feedback.innerHTML = `✅ Pesan siap! Membuka WhatsApp untuk <strong>${name}</strong>... Jika tab baru tidak terbuka otomatis, <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="underline font-bold text-aiBlue">klik tautan ini</a>.`;

      fireConfetti(event);
      window.open(waUrl, "_blank", "noopener,noreferrer");
    }

    // 8. Efek Confetti Lucu Ringan (Canvas 2D)
    const canvas = document.getElementById("confetti-canvas");
    const ctx = canvas.getContext("2d");
    let particles = [];
    let animRunning = false;

    function resizeConfettiCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener("resize", resizeConfettiCanvas);
    resizeConfettiCanvas();

    function fireConfetti(e) {
      const originX = e && e.clientX ? e.clientX : window.innerWidth / 2;
      const originY = e && e.clientY ? e.clientY : window.innerHeight / 2;
      const colors = ["#0F294A", "#F59E0B", "#10B981", "#38BDF8", "#FB7185"];

      for (let i = 0; i < 42; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 3 + Math.random() * 6;
        particles.push({
          x: originX,
          y: originY,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 3,
          size: 6 + Math.random() * 6,
          color: colors[Math.floor(Math.random() * colors.length)],
          rotation: Math.random() * 360,
          rotSpeed: (Math.random() - 0.5) * 12,
          life: 65 + Math.random() * 25
        });
      }

      if (!animRunning) {
        animRunning = true;
        requestAnimationFrame(renderConfetti);
      }
    }

    function renderConfetti() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.22; // gravitasi lembut
        p.rotation += p.rotSpeed;
        p.life -= 1;

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate((p.rotation * Math.PI) / 180);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.65);
        ctx.restore();
      });

      particles = particles.filter((p) => p.life > 0);
      if (particles.length > 0) {
        requestAnimationFrame(renderConfetti);
      } else {
        animRunning = false;
      }
    }
  </script>
